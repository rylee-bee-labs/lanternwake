          "is": true
        }
      ],
      "then": [
        {
          "say": "The ferry lamp burns now. Toll-Yann chalks a lamp at the bottom of every page. His account: a light at the slip, and the crossing is open."
        }
      ]
    },
    {
      "id": "ash-hints",
      "when": {
        "comes-near": {
          "who": "grandmother-ash",
          "distance": 2
        }
      },
      "then": [
        {
          "say": {
            "who": "grandmother-ash",
            "line": "Ask what happened to the bell. Ask Hobb. Ask anyone - but do not ask the priest, not yet. He cannot bear it."
          }
        }
      ]
    },
    {
      "id": "sef-sings",
      "when": {
        "comes-near": {
          "who": "sef",
          "distance": 2
        }
      },
      "then": [
        {
          "say": {
            "who": "sef",
            "line": "The bell wants to be found. It sings in the deep water still. I keep it company until someone comes."
