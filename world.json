      "then": [
        {
          "set": "heard-toll-yann-first"
        },
        {
          "say": {
            "who": "toll-yann",
            "line": "You carry the can. Then you keep the lamps. The boy at the crossing knows the water; I keep the count. Your name is not in my book yet."
          }
        },
        {
          "point-to": "saltreach"
        }
      ]
    },
    {
      "id": "whale-fall",
      "when": {
        "comes-near": {
          "who": "the whale fall",
          "distance": 1
        }
      },
      "then": [
        {
          "say": "The ribs of a whale the sea gave back. The bonepicker says the sea returns everything it takes, in its own time."
        }
      ]
    },
    {
      "id": "barrow-door",
      "when": {
        "comes-near": {
          "who": "the barrow door",
          "distance": 1
        }
      },
      "then": [
        {
          "say": "The barrow breathes cold. Somewhere under it the deep road runs to the sea, and someone keeps it lit."
        }
      ]
    },
    {
      "id": "sea-cave",
      "when": {
        "comes-near": {
          "who": "the sea-cave mouth",
          "distance": 1
        }
      },
      "then": [
        {
          "say": "The tide breathes in and out of the cave. Stone steps go down into the salt cellars."
        }
      ]
    },
    {
      "id": "causeway-ferry-first",
      "when": {
        "comes-near": {
          "who": "the unlit ferry lamp",
          "distance": 1
        }
      },
      "if": [
        {
          "flag": "heard-toll-yann-first",
