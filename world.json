        }
      ],
      "then": [
        {
          "set": "heard-ferry-first"
        },
        {
          "say": {
            "who": "ferry",
            "line": "Quiet pole, quiet water. The water talks first. The lamp at the slip is the crossing, and the toll-keeper keeps the account of every one."
          }
        },
        {
          "point-to": "gullwatch"
        }
      ]
    },
    {
      "id": "causeway-toll-yann-payoff",
      "when": {
        "comes-near": {
