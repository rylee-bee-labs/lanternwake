    {
      "id": "weald-gloom",
      "when": {
        "enters": {
          "place": "the-weald"
        }
      },
      "then": [
        {
          "weather": "fog"
        },
        {
          "say": "The Hush pools between the pines tonight. Keep the Evercan close and walk where the lamps can see you."
        }
      ]
    },
    {
      "id": "causeway-tide",
      "when": {
        "enters": {
          "place": "the-causeway"
        }
      },
      "then": [
        {
          "say": "The tide stands high at deep-night and the causeway walks under water then. Walk it anyway; the road remembers where it is."
        }
      ]
    },
    {
      "id": "beacon-wind",
      "when": {
        "enters": {
          "place": "vesper-point"
        }
      },
      "then": [
        {
          "weather": "clear"
        },
        {
          "say": "The wind scours Vesper Point clean. The Beacon stands over everything, waiting for one flame."
        }
      ]
    },
    {
