            "claim": "the-apprentice-burned-the-hall"
          }
        },
        {
          "say": {
            "who": "aisling",
            "line": "A storm lamp and a dry beam... then the hall burned by accident. I am sorry, apprentice. I wanted it to be someone's fault."
          }
        }
      ]
    },
    {
      "id": "drennan-believes",
      "when": {
