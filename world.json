            "claim": "the-apprentice-burned-the-hall"
          }
        },
        {
          "say": {
            "who": "holt",
            "line": "The road stands open again. I shut it ten years ago out of fear and called it prudence. I am done calling things prudence."
          }
        }
      ]
    },
    {
      "id": "aisling-believes",
      "when": {
        "comes-near": {
