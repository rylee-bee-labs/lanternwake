  "rules": [
    {
      "id": "wake-up",
      "when": {
        "starts": {}
      },
      "then": [
        {
          "give": "the-evercan"
        },
        {
          "say": "The coach leaves you at the Thornhollow gate with the Guild's Evercan and its ledger. Five Great Lamps stand dark along the coast."
        },
        {
          "point-to": "thornhollow"
        }
      ]
    },
    {
      "id": "moss-notices",
      "when": {
        "comes-near": {
          "who": "moss",
          "distance": 2
        }
      },
      "if": [
        {
          "flag": "moss-noticed",
          "is": false
        }
      ],
      "then": [
        {
          "set": "moss-noticed"
        },
        {
          "say": {
            "who": "moss",
            "line": "Mrrp."
          }
        }
      ]
    },
    {
      "id": "marta-welcome",
      "when": {
        "enters": {
          "place": "thornhollow"
        }
      },
      "then": [
        {
          "say": {
            "who": "marta",
            "line": "An apprentice? We had stopped hoping. The lamps are still out there, waiting for someone with oil and patience."
          }
        }
      ]
    },
    {
      "id": "light-the-causeway-lamp",
      "when": {
        "comes-near": {
          "who": "the unlit causeway lamp",
          "distance": 1
        }
      },
      "if": [
        {
          "has": "the-evercan"
        },
        {
          "flag": "the-causeway-lamp-lit",
          "is": false
        }
      ],
      "then": [
        {
          "set": "the-causeway-lamp-lit"
        },
        {
          "give": "wake-token"
        },
        {
          "say": "You pour from the Evercan and strike the flint. The wick takes the oil and wakes: the causeway lamp burns again, and the dark stands back a step."
        },
        {
          "point-to": "saltreach"
        }
      ]
    },
    {
      "id": "light-the-ferry-lamp",
      "when": {
        "comes-near": {
          "who": "the unlit ferry lamp",
          "distance": 1
        }
      },
      "if": [
        {
          "has": "the-evercan"
        },
        {
          "flag": "the-ferry-lamp-lit",
          "is": false
        }
      ],
      "then": [
        {
          "set": "the-ferry-lamp-lit"
        },
        {
          "give": "wake-token"
        },
        {
          "say": "Oil, flint, patience. The ferry lamp catches, and its light lies flat across the water like a road."
        },
        {
          "point-to": "gullwatch"
        }
      ]
    },
    {
      "id": "light-the-cliff-lamp",
      "when": {
        "comes-near": {
          "who": "the unlit cliff lamp",
          "distance": 1
        }
      },
      "if": [
        {
          "has": "the-evercan"
        },
        {
          "flag": "the-cliff-lamp-lit",
          "is": false
        }
      ],
      "then": [
        {
          "set": "the-cliff-lamp-lit"
        },
        {
          "give": "wake-token"
        },
        {
          "say": "The cliff lamp wakes. Far down the reach another lamp answers - or it is a star, keeping faith."
        },
        {
          "point-to": "the-weald"
        }
      ]
    },
    {
      "id": "light-the-weald-lamp",
      "when": {
        "comes-near": {
          "who": "the unlit weald lamp",
          "distance": 1
        }
      },
      "if": [
        {
          "has": "the-evercan"
        },
        {
          "flag": "the-weald-lamp-lit",
          "is": false
        }
      ],
      "then": [
        {
          "set": "the-weald-lamp-lit"
        },
        {
          "give": "wake-token"
        },
        {
          "say": "The weald lamp burns in its ash stump. The pines lean toward it like people at a fire."
        },
        {
          "point-to": "barrow-mouth"
        }
      ]
    },
    {
      "id": "light-the-chapel-lamp",
      "when": {
        "comes-near": {
          "who": "the unlit chapel lamp",
          "distance": 1
        }
      },
      "if": [
        {
          "has": "the-evercan"
        },
        {
          "flag": "the-chapel-lamp-lit",
          "is": false
        }
      ],
      "then": [
        {
          "set": "the-chapel-lamp-lit"
        },
        {
          "give": "wake-token"
        },
        {
          "say": "The chapel lamp takes the flame. The drowned nave stands in its own light, sea and all."
        },
        {
          "point-to": "vesper-point"
        }
      ]
    },
    {
      "id": "the-beacon-lights",
      "when": {
        "comes-near": {
          "who": "the Beacon door",
          "distance": 1
        }
      },
      "if": [
        {
          "has": "the-evercan"
        },
        {
          "all-of": [
            {
              "flag": "the-causeway-lamp-lit",
              "is": true
            },
            {
              "flag": "the-ferry-lamp-lit",
              "is": true
            },
            {
              "flag": "the-cliff-lamp-lit",
              "is": true
            },
            {
              "flag": "the-weald-lamp-lit",
              "is": true
            },
            {
              "flag": "the-chapel-lamp-lit",
              "is": true
            }
          ]
        }
      ],
      "then": [
        {
          "set": "the-beacon-lit"
        },
        {
          "give": "wake-token"
        },
        {
          "weather": "clear"
        },
        {
          "say": "The Beacon takes the light and gives it back a hundredfold. The whole coast stands clear, lamp to lamp, all the way to the water."
        }
      ]
    },
    {
      "id": "ledger-found",
      "when": {
        "picks-up": {
          "what": "a-halfburnt-ledger"
        }
      },
      "then": [
        {
          "set": "the-ledger-found"
        },
        {
          "say": "The Guildhall ledger, half-burnt: the fire began with a storm lamp and a dry beam. It was no one's crime."
        }
      ]
    },
    {
      "id": "seal-found",
      "when": {
        "picks-up": {
          "what": "the-wardens-seal"
        }
      },
      "then": [
        {
          "set": "the-seal-found"
        },
        {
          "say": "Osric Vane's chapel seal, salt-stiff. The Warden was here - and not long gone."
        }
      ]
    },
    {
      "id": "letter-found",
      "when": {
