            "claim": "the-master-lives"
          }
        },
        {
          "say": {
            "who": "vetch",
            "line": "He went toward the bell, not away from it. I have been counting wrong for ten years. Find him."
          }
        }
      ]
    },
    {
      "id": "marta-believes",
      "when": {
        "comes-near": {
          "who": "marta",
          "distance": 2
        }
      },
      "if": [
